flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    User([CLI user]):::edge
    Client([HTTP client]):::edge

    subgraph Interfaces["Interfaces (CLI and stdlib HTTP)"]
        direction TB
        CLI["cli.py<br/>query | ablate | serve"]:::edge
        Router["service.py router<br/>/health /ready /retrieve /metrics"]:::core
        Validate["Request validation<br/>query length, known pipeline, k 1 to 50"]:::control
    end

    subgraph Core["Retrieval pipelines (8 named in pipelines.py)"]
        direction TB
        Registry["Pipeline registry<br/>bm25, tfidf, dense, hybrid, mmr, ..."]:::control
        Chunker["FixedTokenChunker<br/>200-token chunks"]:::core
        Lexical["Sparse retrievers<br/>BM25, TF-IDF, char n-gram, phrase"]:::core
        Dense["Neural dense retriever<br/>skip-gram embeddings, cosine"]:::core
        Fusion["HybridRetriever<br/>reciprocal rank fusion"]:::core
        Rerank["RerankedRetriever<br/>lexical overlap or MMR, pool 20"]:::core
    end

    subgraph State["Data and state (in memory)"]
        direction TB
        Corpus[("Bundled corpus<br/>data/sample.py")]:::data
        Indexes[("Indexed retrievers<br/>one per pipeline")]:::data
        Queries[("Labeled queries<br/>relevant chunk ids")]:::data
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Results["Ranked chunks JSON<br/>id, score, text"]:::obs
        Harness["Evaluation harness<br/>recall, precision, MRR, nDCG"]:::obs
        Compare["compare_retrievers<br/>paired bootstrap significance"]:::obs
        Metrics["ServiceMetrics<br/>Prometheus text"]:::obs
    end

    User -->|arguments| CLI
    Client -->|JSON request| Router
    Router -->|POST /retrieve| Validate
    Validate -->|query, pipeline, k| Registry
    CLI -->|query or ablation| Registry
    Corpus -->|documents| Chunker
    Chunker -->|chunks| Indexes
    Registry -->|builds| Lexical
    Registry -->|builds| Dense
    Indexes -.-> Lexical
    Indexes -.-> Dense
    Lexical -->|rankings| Fusion
    Dense -->|rankings| Fusion
    Fusion -->|top candidates| Rerank
    Rerank -->|top k| Results
    Fusion -->|top k| Results
    Lexical -->|single-retriever top k| Results
    Dense --> Results
    Queries -.->|relevance labels| Harness
    Results -->|per-pipeline rankings| Harness
    Harness -->|same metrics, two pipelines| Compare
    Router -.->|route latency and errors| Metrics
