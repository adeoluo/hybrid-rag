---
title: System Architecture - Hybrid RAG
config:
  theme: base
  themeVariables:
    fontFamily: "Inter, system-ui, sans-serif"
    primaryColor: "#F8FAFC"
    primaryBorderColor: "#1E293B"
    primaryTextColor: "#1E293B"
    lineColor: "#64748B"
    clusterBkg: "#E2E8F0"
    clusterBorder: "#94A3B8"
---
flowchart LR
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef external fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    Docs[(Documents)]:::data
    Query([Query]):::external

    subgraph Index["Indexing"]
        Chunker[Chunker]:::core
    end

    subgraph Retrieval["Retrieval"]
        BM25[BM25]:::core
        Dense[TF-IDF Dense]:::core
        Fusion[Reciprocal Rank Fusion]:::core
        Rerank[Reranker]:::core
    end

    Eval[Evaluation harness]:::core

    Docs --> Chunker
    Chunker -->|chunks| BM25
    Chunker -->|chunks| Dense
    Query --> BM25
    Query --> Dense
    BM25 -->|ranked| Fusion
    Dense -->|ranked| Fusion
    Fusion -->|candidates| Rerank
    Rerank -->|top-k| Query
    Rerank -.->|recall, MRR, nDCG| Eval
