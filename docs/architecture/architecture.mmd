flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Users([Users and clients]):::edge
        CLI["CLI<br/>query, ablate, serve"]:::edge
        Router["HTTP service<br/>/retrieve /metrics"]:::core
        Validate["Validation<br/>query, pipeline, k"]:::control
        Users --> CLI ~~~ Router --> Validate
    end

    subgraph State["Data and state"]
        direction TB
        Corpus[("Bundled corpus")]:::data
        Chunker["Chunker<br/>200-token chunks"]:::core
        Indexes[("Retriever indexes")]:::data
        Queries[("Labeled queries")]:::data
        Corpus --> Chunker --> Indexes ~~~ Queries
    end

    subgraph Core["Retrieval pipelines"]
        direction TB
        Registry["Pipeline registry<br/>8 named pipelines"]:::control
        Lexical["Sparse retrievers<br/>BM25, TF-IDF, n-gram"]:::core
        Dense["Neural dense<br/>skip-gram, cosine"]:::core
        Fusion["Rank fusion<br/>reciprocal rank"]:::core
        Rerank["Reranking<br/>overlap or MMR"]:::core
        Registry --> Lexical --> Fusion
        Registry --> Dense --> Fusion
        Fusion --> Rerank
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Results["Ranked chunks<br/>JSON response"]:::obs
        Harness["Evaluation<br/>recall, MRR, nDCG"]:::obs
        Compare["Significance<br/>paired bootstrap"]:::obs
        Metrics["Metrics<br/>Prometheus text"]:::obs
        Results --> Harness --> Compare
        Harness ~~~ Metrics
    end

    Interfaces -->|query, k| Core
    State -.->|indexes| Core
    Core -->|top k| Obs
